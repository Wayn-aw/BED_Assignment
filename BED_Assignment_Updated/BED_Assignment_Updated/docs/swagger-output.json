    "/api/v1/centres/nea": {
      "get": {
        "tags": [
          "Centres"
        ],
        "summary": "List NEA-registered hawker centres (live from data.gov.sg)",
        "description": "Proxies the data.gov.sg Datastore Search API from the back-end. Responses are cached in memory for one hour to stay within the upstream rate limit; the cached flag in the response tells you which path was taken.",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "description": "Rows to return (1-100).",
            "required": false,
            "schema": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "example": "integer"
                },
                "default": {
                  "type": "number",
                  "example": 20
                }
              }
            }
          },
          {
            "name": "offset",
            "in": "query",
            "description": "Rows to skip, for pagination.",
            "required": false,
            "schema": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "example": "integer"
                },
                "default": {
                  "type": "number",
                  "example": 0
                }
              }
            }
          },
          {
            "name": "search",
            "in": "query",
            "description": "Free-text filter, e.g. Bedok.",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Centres returned."
          },
          "400": {
            "description": "Invalid limit, offset or search value."
          },
          "429": {
            "description": "Upstream rate limit reached."
          },
          "502": {
            "description": "Upstream returned an unexpected response."
          },
          "503": {
            "description": "Upstream unreachable or timed out."
          }
        }
      }
    }
  },
