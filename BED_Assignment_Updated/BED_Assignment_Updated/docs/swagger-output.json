{
  "openapi": "3.0.0",
  "info": {
    "title": "HawkerHub API",
    "version": "1.0.0",
    "description": "RESTful API for the HawkerHub Singapore Hawker Centre Management System. Protected endpoints require a JWT: call POST /api/v1/users/login, copy the token from the response, then click Authorize above and paste it."
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Local development"
    }
  ],
  "tags": [
    {
      "name": "Users",
      "description": "Account management, login, profiles (Kenneth)"
    },
    {
      "name": "Payments",
      "description": "Order payment records (Kenneth)"
    },
    {
      "name": "Stalls",
      "description": "Public browsing of stalls and menus (Kyra)"
    },
    {
      "name": "Feedback",
      "description": "Patron ratings and comments (Kyra)"
    },
    {
      "name": "Complaints",
      "description": "Formal complaints against stalls (Kyra)"
    },
    {
      "name": "Menu",
      "description": "Vendor menu item CRUD (Wayne)"
    },
    {
      "name": "Orders",
      "description": "Cart checkout and order status (Wayne)"
    },
    {
      "name": "Inspections",
      "description": "NEA inspections and hygiene grades (Jeremiah)"
    },
    {
      "name": "Promotions",
      "description": "Stall promotions (Jeremiah)"
    },
    {
      "name": "Rentals",
      "description": "Rental agreement tracking (Yongsheng)"
    },
    {
      "name": "Likes",
      "description": "Likes on individual menu items (Yongsheng)"
    },
    {
      "name": "Analytics",
      "description": "Sales and performance analytics (Yongsheng)"
    },
    {
      "name": "Centres",
      "description": "NEA hawker centre open data via data.gov.sg (third-party API)"
    }
  ],
  "paths": {
    "/api/v1/health": {
      "get": {
        "description": "",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/users/register": {
      "post": {
        "tags": [
          "Users"
        ],
        "summary": "Register a new account",
        "description": "Creates a Patron, Vendor, NEAOfficer, Operator or Admin account. The password is hashed with bcrypt before it is stored.",
        "responses": {
          "201": {
            "description": "Account created successfully."
          },
          "400": {
            "description": "Missing field, invalid role, or password shorter than 6 characters."
          },
          "409": {
            "description": "An account with this email already exists."
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequest"
              }
            }
          }
        }
      }
    },
    "/api/v1/users/login": {
      "post": {
        "tags": [
          "Users"
        ],
        "summary": "Log in and receive a JWT",
        "description": "Returns a signed JWT. Send it on protected routes as the header: Authorization: Bearer <token>",
        "responses": {
          "200": {
            "description": "Login successful, token returned."
          },
          "400": {
            "description": "email or password missing."
          },
          "401": {
            "description": "Invalid email or password."
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          }
        }
      }
    },
    "/api/v1/users/profile": {
      "get": {
        "tags": [
          "Users"
        ],
        "summary": "Get the logged-in users own profile",
        "description": "",
        "parameters": [
          {
            "name": "authorization",
            "in": "header",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Profile returned. Never includes PasswordHash."
          },
          "401": {
            "description": "No token provided."
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "User not found."
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      },
      "put": {
        "tags": [
          "Users"
        ],
        "summary": "Update the logged-in users own profile",
        "description": "",
        "parameters": [
          {
            "name": "authorization",
            "in": "header",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Profile updated."
          },
          "400": {
            "description": "name is required."
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "Not Found"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "name"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "example": "Kenneth Lim"
                  },
                  "phone": {
                    "type": "string",
                    "example": "91234567"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/users/{id}": {
      "get": {
        "tags": [
          "Users"
        ],
        "summary": "Get any user by ID (Admin / Operator only)",
        "description": "",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "UserID"
          },
          {
            "name": "authorization",
            "in": "header",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "User returned."
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Caller is not an Admin or Operator."
          },
          "404": {
            "description": "User not found."
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      },
      "delete": {
        "tags": [
          "Users"
        ],
        "summary": "Deactivate an account (Admin only, soft delete)",
        "description": "Sets IsActive = 0 rather than deleting the row, so past orders and audit history stay intact.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "UserID"
          },
          {
            "name": "authorization",
            "in": "header",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Account deactivated."
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Caller is not an Admin."
          },
          "404": {
            "description": "User not found."
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
